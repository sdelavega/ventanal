[Unit]
Description=Ventanal scheduled render
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ventanal
Group=ventanal
ExecStart=/opt/ventanal/venv/bin/ventanal tick
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ventanal /var/cache/ventanal
