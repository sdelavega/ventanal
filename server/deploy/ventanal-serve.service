[Unit]
Description=Ventanal frame HTTP server
After=network.target

[Service]
User=ventanal
Group=ventanal
ExecStart=/opt/ventanal/venv/bin/ventanal serve
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ventanal /var/cache/ventanal /etc/ventanal

[Install]
WantedBy=multi-user.target
