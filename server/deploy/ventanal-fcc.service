[Unit]
Description=Ventanal weekly local FCC licence index
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ventanal
Group=ventanal
ExecStart=/opt/ventanal/venv/bin/python -m ventanal.solar.worker /etc/ventanal/ventanal.toml
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ventanal /var/cache/ventanal
